<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- protectionLevel includes "development", so adb can grant it:
         adb shell pm grant com.shashi.shield android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility. Without this, Android 11+ filters other apps out of
         queryIntentActivities and both the browser sweep and the phone lock see an empty list, which fails silently, because an empty list is not an error. It cost a full test cycle
         to find: the lock started, the timer ran, and nothing was actually suspended.
         Two scoped queries rather than QUERY_ALL_PACKAGES: web handlers for the sweep, and
         launchable apps for the lock. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Own task so the blocked app never sits behind it in recents. -->
        <activity
            android:screenOrientation="portrait"
            android:name=".BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.shashi.shield.block"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:screenOrientation="portrait"
            android:name=".RelapseActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ScreenGuardActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ScreenGuardService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:screenOrientation="portrait"
            android:name=".DayEditActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".LessonsActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".BadgesActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".PledgeActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".LockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:screenOrientation="portrait"
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".ThoughtWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/thought_widget_info" />
        </receiver>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".Watchdog"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>
</manifest>
