<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome, hard-edged, matching the app. Widgets cannot use the bundled Inter (RemoteViews
     has no typeface-from-resource API), so this falls back to the system sans at the same
     weights and tracking. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SHELDY"
            android:textSize="10sp"
            android:textColor="#4DFFFFFF"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAY 0"
            android:textSize="10sp"
            android:textColor="#99FFFFFF"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_thought"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:text="The urge is a wave. Waves break."
        android:textSize="17sp"
        android:textColor="#FFFFFFFF"
        android:lineSpacingExtra="3dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="TAP FOR PANIC"
        android:textSize="10sp"
        android:textColor="#4DFFFFFF"
        android:letterSpacing="0.18"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
